# Copy to .env (git-ignored) and adjust. Never commit real secrets.
AGENTFLOW_ENV=local
AGENTFLOW_LOG_LEVEL=INFO
# App runtime: low-privilege role (row-level security applies). Migrations: schema owner.
AGENTFLOW_DATABASE_URL=postgresql+asyncpg://agentflow_app:agentflow_app@localhost:5432/agentflow
AGENTFLOW_MIGRATION_DATABASE_URL=postgresql+asyncpg://agentflow:agentflow@localhost:5432/agentflow
AGENTFLOW_REDIS_URL=redis://localhost:6379/0

# LLM provider key (console.groq.com). Put the real value in .env, never in this file.
# GROQ_API_KEY=
# Optional: more Groq keys (comma-separated), tried when the first is rate-limited
# GROQ_API_KEYS=
# Optional second provider (same gpt-oss models)
# CEREBRAS_API_KEY=

# Signs login tokens. Required outside local/test. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# AGENTFLOW_JWT_SECRET=
# Independent keyed-hash secret for imported CNIC verification; also required outside local/test.
# AGENTFLOW_CNIC_HASH_SECRET=
# Keys the audit hash chain; keep it outside the database. Required outside local/test.
# AGENTFLOW_AUDIT_CHAIN_SECRET=
